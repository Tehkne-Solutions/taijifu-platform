{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taijifu.org/schema/content-node.schema.json",
  "title": "Taijifu Content Node",
  "type": "object",
  "required": ["id","canonicalEntityId","type","title","audience","difficulty","status","version"],
  "properties": {
    "id": {"type":"string","pattern":"^CONTENT-[A-Z0-9-]+$"},
    "canonicalEntityId": {"type":"string","pattern":"^(NUC-N\\d{3}|PATH-C\\d{2}|BELT-[A-Z]+|BASE-[A-Z-]+)$"},
    "type": {"enum":["article","lesson","quiz","guided-practice","video","instructor-card","kids-view","lifetime-view","ai-context"]},
    "title": {"type":"string","minLength":1},
    "summary": {"type":"string"},
    "audience": {"type":"array","minItems":1,"items":{"enum":["public","adult","kids","youth","lifetime","instructor","research"]}},
    "difficulty": {"enum":["foundation","developing","advanced","mastery"]},
    "durationMinutes": {"type":"integer","minimum":1},
    "status": {"enum":["draft","published","archived"]},
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "beltId": {"type":"string"},
    "pathId": {"type":"string"}
  },
  "additionalProperties": true
}
