# Official persistence: required for server-side evidence/traversal/evaluation.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Production identity bridge.
# A trusted middleware/identity provider must sign x-taijifu-auth-* headers with this secret.
TAIJIFU_AUTH_BRIDGE_SECRET=replace-with-at-least-32-random-bytes

# Demo auth is opt-in only and must stay disabled in production.
TAIJIFU_ALLOW_DEMO_AUTH=0
TAIJIFU_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Planned Clerk production adapter (provision through Vercel Marketplace / Clerk Dashboard).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
