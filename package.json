{
  "name": "taijifu-platform",
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {"node": ">=22 <23"},
  "scripts": {
    "canon:validate": "node packages/canon/scripts/validate.mjs",
    "canon:summary": "node packages/canon/scripts/summary.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "content:validate": "node packages/content/scripts/validate.mjs",
    "content:summary": "node packages/content/scripts/summary.mjs",
    "validate": "npm run canon:validate && npm run content:validate && npm run evidence:validate && npm run ui:validate && npm run p45:validate && npm run yellow:validate && npm run orange:validate && npm run p5:validate && npm run p6:validate && npm run p6:mvp:validate && npm run ai:validate && npm run p7:validate && npm run p8:validate",
    "ui:validate": "node tooling/validate-ui.mjs",
    "evidence:validate": "node packages/evidence/scripts/validate.mjs",
    "p45:validate": "node tooling/validate-p45.mjs",
    "yellow:validate": "node tooling/validate-yellow-belt.mjs",
    "orange:validate": "node tooling/validate-orange-belt.mjs",
    "p5:validate": "node tooling/validate-p5.mjs",
    "p6:validate": "node tooling/validate-p6.mjs",
    "p6:mvp:validate": "node tooling/validate-p6-mvp.mjs",
    "ai:validate": "node packages/ai/scripts/validate.mjs",
    "p7:validate": "node tooling/validate-p7.mjs",
    "p8:validate": "node tooling/validate-p8.mjs"
  },
  "devDependencies": {
    "turbo": "^2.8.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
